        dhall >= 1.42 && < 1.43,
        directory >= 1.3 && < 1.4,
        filepath >= 1.4 && < 1.6,
        hnix >= 0.17 && < 0.18,
        lsp-types >= 2.3 && < 2.4,
        megaparsec >= 9.0 && < 10.0,
