-- Differential soundness oracle: compares inferred types against
-- `nix-instantiate --eval` (builtins.typeOf). Skips cleanly when
-- nix-instantiate is unavailable (e.g. the sandboxed flake check).
test-suite nix-compile-oracle
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Oracle.hs
    build-depends:
        base >= 4.16 && < 4.21,
        directory >= 1.3 && < 1.4,
        hnix >= 0.17 && < 0.18,
        nix-compile,
        process >= 1.6 && < 1.7,
        text >= 2.0 && < 2.2
    hs-source-dirs:   test
    default-language: GHC2021

benchmark nix-compile-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Bench.hs
    build-depends:
        base >= 4.16 && < 4.21,
        containers >= 0.6 && < 0.8,
        data-fix >= 0.3 && < 0.4,
        deepseq >= 1.4 && < 1.6,
        hnix >= 0.17 && < 0.18,
        nix-compile,
        tasty-bench >= 0.3 && < 0.5,
        text >= 2.0 && < 2.2
    hs-source-dirs:   bench
    default-language: GHC2021
    ghc-options: -rtsopts "-with-rtsopts=-A32m"

benchmark nix-compile-nixpkgs-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          NixpkgsBench.hs
    build-depends:
        base >= 4.16 && < 4.21,
        containers >= 0.6 && < 0.8,
        directory >= 1.3 && < 1.4,
        filepath >= 1.4 && < 1.6,
        nix-compile,
        process >= 1.6 && < 1.7,
        text >= 2.0 && < 2.2,
        time >= 1.12 && < 1.15
    hs-source-dirs:   bench
    default-language: GHC2021
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A32m"
