    import:           warnings
    main-is:          Main.hs
    build-depends:
        aeson >= 2.0 && < 2.3,
        async >= 2.2 && < 2.3,
        base >= 4.16 && < 4.21,
        bytestring >= 0.11 && < 0.13,
        containers >= 0.6 && < 0.8,
        data-fix >= 0.3 && < 0.4,
        dhall >= 1.42 && < 1.43,
        directory >= 1.3 && < 1.4,
        filepath >= 1.4 && < 1.6,
        hnix >= 0.17 && < 0.18,
        katip >= 0.8 && < 0.9,
        megaparsec >= 9.0 && < 10.0,
        mtl >= 2.3 && < 2.4,
        nix-compile,
        ShellCheck >= 0.9 && < 0.12,
        text >= 2.0 && < 2.2,
        transformers >= 0.5 && < 0.7
    hs-source-dirs:   app
    default-language: GHC2021

