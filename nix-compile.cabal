cabal-version:      3.0
name:               nix-compile
version:            0.1.0.0
synopsis:           Type inference for bash scripts at Nix eval time
description:        Eliminates runtime bash bugs by catching type errors, missing variables,
                    and policy violations during the build.
license:            MIT
author:             Aleph Systems
maintainer:         dev@aleph.systems
category:           Development
build-type:         Simple

common warnings
    ghc-options: -Wall -Werror -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

-- Deep-vendored nixfmt (RFC 166), MPL-2.0. Source from nixfmt 1.3.1 under
-- vendor/nixfmt/ (see vendor/nixfmt/LICENSE), brought into our tree as
-- first-class code: it builds under OUR -Wall -Werror flags (modified where
-- needed; changes to these MPL files are themselves MPL). We format via
-- Nixfmt.format for byte-exact parity with the nixfmt binary, then diverge by
-- editing these modules directly.
library nixfmt-vendored
    import:           warnings
    visibility:       private
    exposed-modules:
        Nixfmt
        Nixfmt.Lexer
        Nixfmt.Parser
        Nixfmt.Parser.Float
        Nixfmt.Predoc
        Nixfmt.Pretty
        Nixfmt.Types
        Nixfmt.Util
    hs-source-dirs:   vendor/nixfmt
    default-language: Haskell2010
    -- nixfmt's Pretty/parser instances are orphans by design (the Pretty class
    -- lives in Predoc, the AST types in Types); de-orphaning would mean merging
    -- those modules. Upstream disables this warning for the same reason.
    ghc-options:      -Wno-orphans
    build-depends:
        base,
        containers,
        megaparsec,
        mtl,
        parser-combinators,
        scientific,
        text,
        transformers,
        pretty-simple

library
    import:           warnings
    exposed-modules:
        NixCompile
        NixCompile.Bash.Builtins
        NixCompile.CLI.Bash
        NixCompile.CLI.CI
        NixCompile.CLI.Check
        NixCompile.CLI.Dispatch
        NixCompile.CLI.Report
        NixCompile.CLI.Types
        NixCompile.Config
        NixCompile.Diagnostic
        NixCompile.Bash.Facts
        NixCompile.Bash.Parse
        NixCompile.Bash.Patterns
        NixCompile.Docs.Extract
        NixCompile.Docs.Search
        NixCompile.Docs.Types
        NixCompile.Emit.Config
        NixCompile.Infer.Constraint
        NixCompile.Infer.Unify
        NixCompile.Lint.Forbidden
        NixCompile.Log
        NixCompile.LSP.Handlers
        NixCompile.LSP.ProjectCache
        NixCompile.LSP.Server
        NixCompile.Nix.Inference
        NixCompile.Nix.Effect
        NixCompile.Nix.Flake
        NixCompile.Nix.Infer
        NixCompile.Nix.LayoutConvention
        NixCompile.Nix.Lint
        NixCompile.Nix.LintCombined
        NixCompile.Nix.LintDerivation
        NixCompile.Nix.LintPackages
        NixCompile.Nix.LintPatterns
        NixCompile.Nix.Module
        NixCompile.Nix.ModuleKind
        NixCompile.Nix.ModuleSystem
        NixCompile.Nix.Naming
        NixCompile.Nix.Parse
        NixCompile.Nix.Formatter
        NixCompile.Nix.Scope
        NixCompile.Nix.Types
        NixCompile.Nix.Utils
        NixCompile.Pretty
        NixCompile.Safety
        NixCompile.Schema.Build
        NixCompile.Types
    build-depends:
        aeson >= 2.0 && < 2.3,
        async >= 2.2 && < 2.3,
        base >= 4.16 && < 4.21,
        bytestring >= 0.11 && < 0.13,
        containers >= 0.6 && < 0.8,
        cryptohash-sha256 >= 0.11 && < 0.12,
        data-fix >= 0.3 && < 0.4,
        dhall >= 1.42 && < 1.43,
        directory >= 1.3 && < 1.4,
        filepath >= 1.4 && < 1.6,
        hnix >= 0.17 && < 0.18,
        katip >= 0.8 && < 0.9,
        lsp >= 2.7 && < 2.8,
        lsp-types >= 2.3 && < 2.4,
        megaparsec >= 9.0 && < 10.0,
        mtl >= 2.3 && < 2.4,
        prettyprinter >= 1.7 && < 1.8,
        prettyprinter-ansi-terminal >= 1.1 && < 1.2,
        ShellCheck >= 0.9 && < 0.12,
        stm >= 2.5 && < 2.6,
        text >= 2.0 && < 2.2,
        transformers >= 0.5 && < 0.7,
        nixfmt-vendored
    hs-source-dirs:   lib
    default-language: GHC2021

